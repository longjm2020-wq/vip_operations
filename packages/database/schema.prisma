generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     BigInt                   @id @default(autoincrement())
  username               String                   @unique @db.VarChar(100)
  display_name           String                   @db.VarChar(100)
  password_hash          String
  status                 String                   @default("ACTIVE") @db.VarChar(32)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  audit_logs             audit_logs[]
  idempotency_records    idempotency_records[]
  inventory_adjustments  inventory_adjustments[]
  inventory_transactions inventory_transactions[]
  purchase_orders        purchase_orders[]
  receipts               receipts[]
  sessions               sessions[]
  user_roles             user_roles[]

  @@map("users")
}

model audit_logs {
  id          BigInt   @id @default(autoincrement())
  actor_id    BigInt?
  actor_label String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   BigInt?
  request_id  String   @db.VarChar(100)
  before_data Json?
  after_data  Json?
  reason      String?
  occurred_at DateTime @default(now()) @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  users       User?    @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_id, occurred_at])
  @@index([entity_type, entity_id, occurred_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model brands {
  id         BigInt     @id @default(autoincrement())
  code       String     @unique @db.VarChar(50)
  name       String     @db.VarChar(100)
  status     String     @default("ACTIVE") @db.VarChar(32)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  products   products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  id               BigInt       @id @default(autoincrement())
  code             String       @unique @db.VarChar(50)
  name             String       @db.VarChar(100)
  parent_id        BigInt?
  status           String       @default("ACTIVE") @db.VarChar(32)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]
}

model idempotency_records {
  id              BigInt   @id @default(autoincrement())
  actor_id        BigInt
  operation       String   @db.VarChar(150)
  idempotency_key String   @db.VarChar(128)
  request_hash    String   @db.VarChar(128)
  response_status Int
  response_body   Json
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  users           User     @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([actor_id, operation, idempotency_key])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_adjustments {
  id                     BigInt                  @id @default(autoincrement())
  adjustment_no          String                  @unique @db.VarChar(50)
  warehouse_id           BigInt
  sku_id                 BigInt
  quantity               Int
  reason                 String                  @db.VarChar(50)
  remark                 String
  operator_id            BigInt
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @db.Timestamptz(6)
  users                  User                    @relation(fields: [operator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skus                   skus                    @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses             warehouses              @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_transactions inventory_transactions?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_balances {
  id           BigInt     @id @default(autoincrement())
  warehouse_id BigInt
  sku_id       BigInt
  physical_qty Int        @default(0)
  reserved_qty Int        @default(0)
  damaged_qty  Int        @default(0)
  version      Int        @default(0)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)
  skus         skus       @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses   warehouses @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([warehouse_id, sku_id])
  @@index([sku_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_transactions {
  id                    BigInt                 @id @default(autoincrement())
  warehouse_id          BigInt
  sku_id                BigInt
  transaction_type      String                 @db.VarChar(50)
  physical_delta        Int
  reserved_delta        Int                    @default(0)
  damaged_delta         Int                    @default(0)
  before_physical       Int
  after_physical        Int
  before_reserved       Int
  after_reserved        Int
  before_damaged        Int
  after_damaged         Int
  source_type           String                 @db.VarChar(50)
  source_id             BigInt
  source_no             String                 @db.VarChar(100)
  receipt_item_id       BigInt?                @unique
  adjustment_id         BigInt?                @unique
  occurred_at           DateTime               @default(now()) @db.Timestamptz(6)
  operator_id           BigInt
  remark                String?
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  inventory_adjustments inventory_adjustments? @relation(fields: [adjustment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 User                   @relation(fields: [operator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipt_items         receipt_items?         @relation(fields: [receipt_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skus                  skus                   @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses            warehouses             @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([source_type, source_id])
  @@index([warehouse_id, sku_id, occurred_at, id])
}

model permissions {
  id               BigInt             @id @default(autoincrement())
  code             String             @unique @db.VarChar(100)
  name             String             @db.VarChar(100)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                  BigInt     @id @default(autoincrement())
  style_no            String     @unique @db.VarChar(64)
  name                String     @db.VarChar(255)
  brand_id            BigInt?
  category_id         BigInt
  default_supplier_id BigInt?
  year                Int?       @db.SmallInt
  season              String?    @db.VarChar(32)
  tag_price           Decimal?   @db.Decimal(14, 2)
  main_image_url      String?
  remark              String?
  status              String     @default("ACTIVE") @db.VarChar(32)
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime   @default(now()) @db.Timestamptz(6)
  brands              brands?    @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories          categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers           suppliers? @relation(fields: [default_supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skus                skus[]

  @@index([category_id])
  @@index([default_supplier_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_order_items {
  id                     BigInt                @id @default(autoincrement())
  purchase_order_id      BigInt
  sku_id                 BigInt
  purchase_suggestion_id BigInt?               @unique
  ordered_qty            Int
  unit_cost              Decimal               @db.Decimal(14, 2)
  received_qty           Int                   @default(0)
  cancelled_qty          Int                   @default(0)
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @db.Timestamptz(6)
  purchase_orders        purchase_orders       @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_suggestions   purchase_suggestions? @relation(fields: [purchase_suggestion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skus                   skus                  @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipt_items          receipt_items[]

  @@index([purchase_order_id])
  @@index([sku_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_orders {
  id                   BigInt                 @id @default(autoincrement())
  po_no                String                 @unique @db.VarChar(50)
  supplier_id          BigInt
  warehouse_id         BigInt
  buyer_id             BigInt
  ordered_at           DateTime?              @db.Timestamptz(6)
  expected_delivery_at DateTime?              @db.Timestamptz(6)
  status               String                 @default("DRAFT") @db.VarChar(32)
  total_qty            Int                    @default(0)
  total_amount         Decimal                @default(0) @db.Decimal(14, 2)
  version              Int                    @default(0)
  remark               String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  purchase_order_items purchase_order_items[]
  users                User                   @relation(fields: [buyer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers            suppliers              @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses           warehouses             @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipts             receipts[]

  @@index([supplier_id, created_at])
  @@index([warehouse_id, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_suggestions {
  id                      BigInt                @id @default(autoincrement())
  sku_id                  BigInt                @unique(map: "suggestion_active", where: raw("((status)::text = ANY ((ARRAY['PENDING'::character varying, 'ACCEPTED'::character varying, 'MODIFIED'::character varying])::text[]))"))
  supplier_id             BigInt?
  generated_at            DateTime              @default(now()) @db.Timestamptz(6)
  available_qty_snapshot  Int
  in_transit_qty_snapshot Int
  sales_7d_snapshot       Int
  sales_30d_snapshot      Int?
  avg_daily_sales         Decimal               @db.Decimal(12, 4)
  target_stock_days       Int
  suggested_qty           Int
  risk_level              String?               @db.VarChar(32)
  status                  String                @default("PENDING") @db.VarChar(32)
  actual_purchase_qty     Int?
  decision_reason         String?
  ignored_reason          String?               @db.VarChar(100)
  ignored_remark          String?
  source_kind             String                @db.VarChar(32)
  algorithm_version       String                @db.VarChar(50)
  input_snapshot          Json
  created_at              DateTime              @default(now()) @db.Timestamptz(6)
  updated_at              DateTime              @default(now()) @db.Timestamptz(6)
  purchase_order_items    purchase_order_items?
  skus                    skus                  @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers               suppliers?            @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, generated_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model receipt_items {
  id                     BigInt                  @id @default(autoincrement())
  receipt_id             BigInt
  purchase_order_item_id BigInt
  sku_id                 BigInt
  received_qty           Int
  qualified_qty          Int                     @default(0)
  damaged_qty            Int                     @default(0)
  shortage_qty           Int                     @default(0)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @db.Timestamptz(6)
  inventory_transactions inventory_transactions?
  purchase_order_items   purchase_order_items    @relation(fields: [purchase_order_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipts               receipts                @relation(fields: [receipt_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skus                   skus                    @relation(fields: [sku_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([receipt_id, purchase_order_item_id])
  @@index([purchase_order_item_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model receipts {
  id                BigInt          @id @default(autoincrement())
  receipt_no        String          @unique @db.VarChar(50)
  purchase_order_id BigInt
  warehouse_id      BigInt
  received_at       DateTime?       @db.Timestamptz(6)
  posted_at         DateTime?       @db.Timestamptz(6)
  status            String          @default("DRAFT") @db.VarChar(32)
  operator_id       BigInt
  version           Int             @default(0)
  remark            String?
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)
  receipt_items     receipt_items[]
  users             User            @relation(fields: [operator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders   purchase_orders @relation(fields: [purchase_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses        warehouses      @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([purchase_order_id, status])
}

model role_permissions {
  role_id       BigInt
  permission_id BigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id               BigInt             @id @default(autoincrement())
  code             String             @unique @db.VarChar(50)
  name             String             @db.VarChar(100)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model schema_migrations {
  name       String   @id
  checksum   String
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model sessions {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token_hash String    @unique @db.VarChar(128)
  csrf_token String    @db.VarChar(128)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  users      User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expires_at])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model skus {
  id                     BigInt                   @id @default(autoincrement())
  product_id             BigInt
  sku_code               String                   @unique @db.VarChar(100)
  barcode                String?                  @db.VarChar(100)
  color_code             String                   @db.VarChar(50)
  color_name             String                   @db.VarChar(100)
  size_code              String                   @db.VarChar(50)
  size_name              String                   @db.VarChar(100)
  cost_price             Decimal?                 @db.Decimal(14, 2)
  status                 String                   @default("ACTIVE") @db.VarChar(32)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  inventory_adjustments  inventory_adjustments[]
  inventory_balances     inventory_balances[]
  inventory_transactions inventory_transactions[]
  purchase_order_items   purchase_order_items[]
  purchase_suggestions   purchase_suggestions?
  receipt_items          receipt_items[]
  products               products                 @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([barcode])
  @@index([product_id, color_code, size_code])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model suppliers {
  id                     BigInt                 @id @default(autoincrement())
  supplier_code          String                 @unique @db.VarChar(50)
  name                   String                 @db.VarChar(255)
  contact_name           String?                @db.VarChar(100)
  phone                  String?                @db.VarChar(50)
  address                String?
  default_lead_time_days Int?
  moq                    Int?
  status                 String                 @default("ACTIVE") @db.VarChar(32)
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  products               products[]
  purchase_orders        purchase_orders[]
  purchase_suggestions   purchase_suggestions[]
}

model user_roles {
  user_id BigInt
  role_id BigInt
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users   User   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, role_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model warehouses {
  id                     BigInt                   @id @default(autoincrement())
  code                   String                   @unique @db.VarChar(50)
  name                   String                   @db.VarChar(100)
  address                String?
  status                 String                   @default("ACTIVE") @db.VarChar(32)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  inventory_adjustments  inventory_adjustments[]
  inventory_balances     inventory_balances[]
  inventory_transactions inventory_transactions[]
  purchase_orders        purchase_orders[]
  receipts               receipts[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model color_mappings {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique @db.VarChar(3)
  name       String   @db.VarChar(100)
  status     String   @default("ACTIVE") @db.VarChar(32)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model size_mappings {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique @db.VarChar(3)
  name       String   @db.VarChar(100)
  status     String   @default("ACTIVE") @db.VarChar(32)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}
