DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
PORT=3100
APP_ORIGIN=http://localhost:5173
SESSION_TTL=28800
BUSINESS_TIMEZONE=Asia/Shanghai
VIP_MODE=disabled
SALES_SOURCE=unavailable
# Phase 3 Compass placeholders. Reuse VOP_APP_KEY/VOP_APP_SECRET/VOP_VENDOR_ID
# from the catalog connection; keep Compass disabled until a read-only call passes.
VOP_COMPASS_ACCOUNT=
# Store the PEM outside the repository and provide its absolute path.
VOP_COMPASS_PRIVATE_KEY_FILE=
# Each metric/report uses an API code published inside 魔方罗盘取数 API.
VOP_COMPASS_API_CODE=
# JSON object whose values are strings; fields depend on the selected API code.
VOP_COMPASS_QUERY_JSON={}
# Set only while running db:seed. No default password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Docker Compose only. Use a URL-safe random password, or encode URL components.
POSTGRES_PASSWORD=
COMPOSE_ORIGIN=http://localhost:8080

# Database URL with the Compose postgres service host; set locally.
COMPOSE_DATABASE_URL=

# Optional express tracking, configured only after a logistics service is purchased.
# Keep disabled until a live account is available. Set on both API and worker.
LOGISTICS_PROVIDER=disabled
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
