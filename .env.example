DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
PORT=3100
APP_ORIGIN=http://localhost:5173
SESSION_TTL=28800
BUSINESS_TIMEZONE=Asia/Shanghai
VIP_MODE=disabled
# Read-only listing status for collected schedule barcodes when VIP_MODE=catalog.
# Set off on Worker to pause status requests while retaining saved observations.
VOP_LISTING_SYNC_ENABLED=on
SALES_SOURCE=unavailable
# With S3 configured, historical selection images are copied and verified on API startup.
# Set off to pause copying; existing images and new object-storage uploads still work.
SELECTION_IMAGE_MIGRATION=on
# Compass read-only single-page probe. Reuse the catalog VOP application.
# Requires commercial enablement, registered RSA public key and an explicit API-code contract.
# Configure on Worker only. Never put keys or browser sessions in source control.
VOP_COMPASS_ACCOUNT=
# Store the PEM outside the repository and provide its absolute path.
VOP_COMPASS_PRIVATE_KEY_FILE=
# Each metric/report uses an API code published inside 魔方罗盘取数 API.
VOP_COMPASS_API_CODE=
# Explicit JSON object of string values; use {} only if the API-code contract permits it.
VOP_COMPASS_QUERY_JSON=
# Set only while running db:seed. No default password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Docker Compose only. Use a URL-safe random password, or encode URL components.
POSTGRES_PASSWORD=
COMPOSE_ORIGIN=http://localhost:8080

# Database URL with the Compose postgres service host; set locally.
COMPOSE_DATABASE_URL=

# Optional express tracking, configured only after a logistics service is purchased.
# Keep disabled until a live account is available. Set on both API and worker.
LOGISTICS_PROVIDER=disabled
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=

# Same random 32-byte key (64 hex characters) on API and worker. Encrypts SMTP credentials.
# Keep this secret outside Git; configure addresses and authorization code in the app.
COMPASS_MAIL_KEY=
