FROM node:24.21.0-bookworm-slim AS build
WORKDIR /app
RUN apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends ffmpeg openssl \
    && rm -rf /var/lib/apt/lists/*
ENV FFMPEG_BIN=/usr/bin/ffmpeg
RUN npm install -g pnpm@10.32.1
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm db:generate && pnpm build
ARG PREVIOUS_WEB_ASSET_ORIGIN=https://vip-web-production.up.railway.app
RUN node scripts/retain-web-assets.mjs /app/dist/web "$PREVIOUS_WEB_ASSET_ORIGIN"
FROM nginx:1.28-alpine
ENV API_UPSTREAM=api:3100
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
ENV NGINX_ENVSUBST_FILTER="^(API_UPSTREAM|NGINX_LOCAL_RESOLVERS)$"
COPY --from=build /app/dist/web /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template
EXPOSE 80
